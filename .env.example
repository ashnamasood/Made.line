# Postgres connection string (Neon, Vercel Postgres, Supabase — any of them).
# Copy to .env.local for development and set the same var in Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HTTP Basic Auth for /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Order notification email (Resend). Without these, orders still save and
# the failure is logged — the customer never sees an error.
RESEND_API_KEY=re_xxxxxxxx
# Defaults to ashna@credminds.com if unset (see src/lib/email.ts).
ADMIN_EMAIL=ashna@credminds.com
FROM_EMAIL=MADE.line <orders@yourdomain.com>
